# Web server
PORT=4400
# How many runs may execute at the same time (each test runs its own browser)
MAX_PARALLEL_RUNS=2
# Seconds a page may take to load (slow dev servers or tunnels need more)
PAGE_LOAD_TIMEOUT=300

# AI providers. Leave the keys empty to use the logged-in `claude` CLI (your Claude subscription).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
